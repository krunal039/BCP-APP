NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Postgres (West Europe in Azure). Required for auth/DB routes — not needed for /health.
DATABASE_URL=postgresql://bcp:bcp@localhost:5432/bcp_dev?schema=public
# HMAC secret for access JWTs (min 32 chars). Override in every non-dev environment.
JWT_SECRET=dev-only-change-me-jwt-secret-32chars!!
# Access token lifetime (@fastify/jwt expiresIn). Logout bumps User.tokenVersion to revoke early.
JWT_EXPIRES_IN=8h
# Optional seed admin (used by `pnpm --filter @bcp/api db:seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeAdmin1!
SEED_ADMIN_DISPLAY_NAME="BCP Admin"

# --- Azure Communication Services SMS (E5) ---
# Leave unset for local/CI — fan-out uses the in-memory stub DeliveryPort.
# When BOTH ACS_CONNECTION_STRING and ACS_PHONE_NUMBER (or SMS_FROM) are set,
# approve/bypass fan-out sends real SMS via @azure/communication-sms.
# ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
# ACS_PHONE_NUMBER=+15555550100
# SMS_FROM=+15555550100
# Optional shared secret for POST /webhooks/acs/sms-delivery
# (header x-acs-webhook-secret or Authorization: Bearer …)
# ACS_WEBHOOK_SECRET=replace-me-in-key-vault
