{
  "name": "@bcp/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:unit": "tsx --test src/auth/password.test.ts src/auth/lockout.test.ts src/auth/rbac.test.ts src/members/csv.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/auth/auth.integration.test.ts src/members/members.integration.test.ts src/alerts/dual-control.test.ts src/alerts/alerts.integration.test.ts",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "smoke:auth": "bash scripts/smoke-auth.sh",
    "smoke:members": "bash scripts/smoke-members.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bcp/shared": "workspace:*",
    "@fastify/jwt": "^9.1.0",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.6.0",
    "argon2": "^0.43.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
