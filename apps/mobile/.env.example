# Expo public API URL (baked into the JS bundle).
# iOS simulator / Expo web: http://localhost:3001
# Android emulator:        http://10.0.2.2:3001
# Physical device:         http://<your-lan-ip>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Push notifications: after login the app requests permission and POSTs the
# Expo push token to /me/device-tokens. Physical device required (simulators skip).
# No App Store / Play submission in MVP — Expo Go or a dev client is enough for pilot.
# Link a Member.userId to the logged-in user so fan-out includes the push channel.
